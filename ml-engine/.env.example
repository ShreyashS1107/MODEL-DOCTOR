# ML Engine Environment Configuration
APP_NAME=Model Doctor ML Engine
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# MinIO / S3 Storage config for model artifacts & dataset partitions
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=model-doctor-artifacts
S3_USE_SSL=false
